# ─── Required ────────────────────────────────────────────────────────────────

# OpenAI API key — used for chat, outfit search, image validation, and AI enhance
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── Optional (AR Virtual Try-On) ────────────────────────────────────────────

# Modal GPU endpoint URL for the virtual try-on service
# If set, the frontend calls Modal directly (no Express backend needed)
VITE_MODAL_URL=https://your-modal-project--stylesense-tryon-web.modal.run

# Express backend URL (only needed if NOT using VITE_MODAL_URL)
# Leave empty if you are using Modal
VITE_BACKEND_URL=
